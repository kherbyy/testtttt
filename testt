-- BTP Helper Functions
local function BTP_alive(plr)
    local c = plr and plr.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not (h and h.Health > 0) then return false end
    local st = c and c:FindFirstChild("State")
    if st and st:FindFirstChild("Down") and st.Down.Value then return false end
    if c and c:FindFirstChild("ForceField") then return false end
    return true
end

local function BTP_aimPart(plr)
    if not BTP_alive(plr) then return nil end
    local c = plr.Character
    if getgenv().BTP.ClosestPart then
        local best, mag = nil, math.huge
        local m = UserInputService:GetMouseLocation()
        for _,p in ipairs(c:GetChildren()) do
            if p:IsA("BasePart") then
                local v,on = Camera:WorldToViewportPoint(p.Position)
                if on then
                    local d = (Vector2.new(v.X,v.Y)-m).Magnitude
                    if d < mag then best,mag = p,d end
                end
            end
        end
        return best
    end
    return c:FindFirstChild(getgenv().BTP.Part) or c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Head")
end

local function BTP_targetFOV()
    local m = UserInputService:GetMouseLocation()
    local best, dmin = nil, math.huge
    for _,pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and BTP_alive(pl) and pl.Character then
            local hrp = pl.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local v,on = Camera:WorldToViewportPoint(hrp.Position)
                if on then
                    local d = (Vector2.new(v.X,v.Y)-m).Magnitude
                    if d <= getgenv().BTP.FOV and d < dmin then best,dmin = pl,d end
                end
            end
        end
    end
    return best
end

local function BTP_currentTarget()
    if getgenv().BTP.Mode == "Target" and getgenv().BTP_lockedTarget and BTP_alive(getgenv().BTP_lockedTarget) then 
        return getgenv().BTP_lockedTarget 
    end
    return BTP_targetFOV()
end

local function BTP_gripFrom(handCF, targetCF)
    local origin = handCF * CFrame.new(0,-1,0, 1,0,0, 0,0,1, 0,-1,0)
    return origin:ToObjectSpace(targetCF):Inverse()
end

local function BTP_canShoot(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local tool = char:FindFirstChildWhichIsA("Tool")
    return hum and hum.Health > 0 and tool and tool:FindFirstChild("Handle")
end

local BTP_lastSwap, BTP_swapping = 0, false
local function BTP_doBTP(tool)
    if not getgenv().BTP.Enabled or BTP_swapping then return end
    local char = LP.Character
    if not (tool and tool:IsA("Tool") and tool:FindFirstChild("Handle") and BTP_canShoot(char)) then return end
    
    local tgtPlr = BTP_currentTarget()
    local part = tgtPlr and BTP_aimPart(tgtPlr) or nil
    if not part then return end

    local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    local endpoint = part.Position + vel * getgenv().BTP.Prediction
    local offset = -Camera.CFrame.LookVector * 0.2
    local targetCF = CFrame.new(endpoint + offset, endpoint + Camera.CFrame.LookVector)
    local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"); if not hand then return end

    local base = (Configuration and Configuration[tool.Name] and Configuration[tool.Name].Cooldown) or 0.45
    local cd = math.clamp(base * getgenv().BTP.SwapScale, getgenv().BTP.SwapMin, getgenv().BTP.SwapMax)
    if tick() - BTP_lastSwap < cd then return end

    local saved = tool.Grip
    local newGrip = BTP_gripFrom(hand.CFrame, targetCF)
    local backpack = LP:FindFirstChild("Backpack") or LP:FindFirstChildOfClass("Backpack"); if not backpack then return end

    BTP_swapping = true
    tool.Parent = backpack; tool.Grip = newGrip; tool.Parent = char
    RunService.RenderStepped:Wait()
    tool.Parent = backpack; tool.Grip = saved; tool.Parent = char
    BTP_lastSwap = tick()
    BTP_swapping = false
end

local BTP_hooked = setmetatable({}, {__mode='k'})
local function BTP_hookTool(tool)
    if BTP_hooked[tool] or not tool:IsA("Tool") or not tool:FindFirstChild("Handle") then return end
    BTP_hooked[tool] = true
    tool.Activated:Connect(function() pcall(BTP_doBTP, tool) end)
end

local function BTP_scan(char)
    for _,v in ipairs(char:GetChildren()) do if v:IsA("Tool") then BTP_hookTool(v) end end
    char.ChildAdded:Connect(function(ch) if ch:IsA("Tool") then BTP_hookTool(ch) end end)
end

